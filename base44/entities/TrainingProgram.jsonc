{
  "name": "TrainingProgram",
  "type": "object",
  "properties": {
    "creator_email": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "sport": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "elite"
      ]
    },
    "duration_weeks": {
      "type": "number"
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sets": {
            "type": "number"
          },
          "reps": {
            "type": "string"
          },
          "rest_seconds": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "followers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of users following this program"
    },
    "is_public": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "creator_email",
    "title",
    "sport"
  ]
}